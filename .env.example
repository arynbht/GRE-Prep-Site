# ---------------------------------------------------------------- database
# Turso / libSQL connection. Both are read server-side only (server/db.ts).
# Never expose these to the browser. Both are required.
#
# Hosted Turso:
#   TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
#   TURSO_AUTH_TOKEN=eyJhbGciOi...
#
# Local libSQL file (auth token is unused but must still be set to something):
#   TURSO_DATABASE_URL=file:local.db
#   TURSO_AUTH_TOKEN=unused

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ------------------------------------------------------------ local models
# Optional. Used for grading short-answer and essay questions, generating new
# questions, and explaining a question on request. Nothing here is required:
# if no local model is reachable the app runs exactly as it does without one.
#
# Ollama (https://ollama.com) listens on 11434 by default.
OLLAMA_BASE_URL=http://127.0.0.1:11434
#
# Any OpenAI-compatible local server: LM Studio (port 1234), llama.cpp server,
# vLLM, text-generation-webui. Point this at the /v1 base.
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
#
# How long to wait on a local model before giving up (milliseconds).
AI_TIMEOUT_MS=180000

# Context window for local model calls. Raise this if question generation
# fails with a reply that was cut off mid-answer.
AI_CONTEXT_TOKENS=8192
